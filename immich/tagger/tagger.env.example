# /etc/immich-event-tagger/tagger.env にコピーして編集する（API キーが入るので権限は 600）
#   sudo install -d -m 755 /etc/immich-event-tagger
#   sudo install -m 600 -o pi tagger.env.example /etc/immich-event-tagger/tagger.env

# Immich の URL（ラズパイの上で動かすので localhost）
IMMICH_URL=http://localhost:2283

# Immich の「アカウント設定」→「API キー」で作ったキー（外部ライブラリの所有者のアカウントで作る。
# 見張りモードを使うときは、管理者のアカウントで作る）
IMMICH_API_KEY=

# 外部ライブラリのフォルダ（Immich のコンテナの中のパス。/mnt/nas/photos ではない）
PHOTOS_ROOT=/mnt/media/photos

# album（アルバムだけ。既定）/ tag（タグだけ）/ both（両方）
MODE=album

# アルバム名とタグ名の決め方。使える値: {year} {yy} {mmdd} {mm} {dd} {name} {folder}
#   例 2026/1003_運動会 → {year}=2026 {yy}=26 {mmdd}=1003 {name}=運動会 {folder}=1003_運動会
# 既定は年の下 2 桁＋フォルダ名（261003_運動会）。別の年に同じフォルダ名があってもアルバムが分かれる
ALBUM_FORMAT={yy}{folder}
# MODE=tag / both のときのタグ名。「/」で階層になる
TAG_FORMAT=イベント/{year}/{folder}

# 対象外にするイベント名（正規表現。空なら全部が対象）。$ を使うときは ' で囲む。例: EXCLUDE='^日常$'
EXCLUDE=

# 対象の年（カンマ区切り。空なら全部）。例: 2025,2026
YEARS=

# 1 にすると、イベントフォルダがなくなった（名前を変えた・消した）タグを消す（MODE=tag / both のとき。アルバムは消さない）
PRUNE=0

# 1 にすると書き込みをせず、することだけをログに出す
DRY_RUN=0

# ---- 見張りモード（--watch、immich-event-watch.service）で使う ----
# ラズパイから見た NAS の写真のフォルダ（backup/fstab.example のマウント先）。ここの更新時刻を見る
NAS_PHOTOS_DIR=/mnt/nas/photos
# 更新時刻を見る間隔（秒）
WATCH_INTERVAL=60
# スキャンを頼んだあと、終わるのを待つ最長の秒数
SCAN_TIMEOUT=900
# 外部ライブラリの ID。空なら PHOTOS_ROOT を取り込んでいるライブラリを自動で探す
LIBRARY_ID=
# 全体の実行と見張りモードが同時に書き込まないための鍵のファイル
LOCK_FILE=/run/lock/immich-event-tagger.lock
