[Unit]
Description=NAS のイベントフォルダを Immich のアルバムにする
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=pi
EnvironmentFile=/etc/immich-event-tagger/tagger.env
ExecStart=/usr/bin/python3 /opt/nas-photo-backup/immich/tagger/event_tagger.py
Nice=10
