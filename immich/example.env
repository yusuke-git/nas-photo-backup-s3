# .env にコピーして使う（.env は Git に入れない）
#   cp example.env .env && chmod 600 .env
# 変数の一覧: https://docs.immich.app/install/environment-variables

# Immich のバージョン。v3 系の最新に追従する。更新で壊れたら "v3.x.y" のように固定する
IMMICH_VERSION=v3

TZ=Asia/Tokyo

# Immich が作る動画変換・DB ダンプなどの置き場所（ラズパイの USB SSD を推奨。SD カードは書き込みで傷みやすい）
UPLOAD_LOCATION=/srv/immich/library

# サムネイルの置き場所（NAS の Thumbnail 共有。backup/fstab.example で読み書きでマウント済みのもの）
THUMB_LOCATION=/mnt/nas/thumbnail

# PostgreSQL のデータ。必ずラズパイのローカルディスクに置く（NAS などのネットワーク共有は不可）
DB_DATA_LOCATION=/srv/immich/postgres

# DB の置き場所が SSD なら SSD、HDD や SD カードなら HDD
DB_STORAGE_TYPE=SSD

# NAS の写真のマウント先（backup/fstab.example と同じ。読み取り専用でマウント済みのもの）
PHOTOS_LOCATION=/mnt/nas/photos

# 英数字だけのランダムな文字列に変える（例: openssl rand -hex 24）
DB_PASSWORD=change-me

# 以下は変更不要
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
